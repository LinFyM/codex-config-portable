output/

# Local worktree directories.
.worktrees/
worktrees/

# Python cache.
**/__pycache__/
**/*.pyc
**/*.pyo

# Local credentials; keep explicit example templates portable.
.env
.env.*
!.env.example

# OS/editor noise.
.DS_Store
.vscode/
