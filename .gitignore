.codex/history.jsonl
.codex/models_cache.json
.codex/cap_sid
.codex/installation_id
.codex/version.json
.codex/*.sqlite*
.codex/*.log
.codex/*.bak*
.codex/*.backup*
.codex/AGENTS.md.*
.codex/sessions/
.codex/archived_sessions/
.codex/shell_snapshots/
.codex/log/
.codex/logs/
.codex/tmp/
.codex/.tmp/
.codex/cache/
.codex/backups/
.codex/memories/
